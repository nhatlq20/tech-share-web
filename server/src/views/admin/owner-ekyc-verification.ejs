<div style="display: flex; flex-direction: column; gap: 20px;">
  <!-- 1. Header & Filters -->
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
    <div>
      <div style="display: flex; align-items: center; gap: 10px;">
        <div style="width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg, #E8F6F7 0%, #D1EFF1 100%); display: flex; align-items: center; justify-content: center; color: #286E74;">
          <i data-lucide="crown" style="width: 20px; height: 20px;"></i>
        </div>
        <h1 style="font-size: 22px; font-weight: 800; color: #0F172A; letter-spacing: -0.02em; margin: 0;">
          Xét duyệt Nâng cấp Chủ thiết bị (Owner Verification)
        </h1>
      </div>
      <p style="font-size: 12px; color: #64748B; margin-top: 6px; margin-bottom: 0;">
        Xét duyệt hồ sơ định danh CCCD và ảnh chân dung cầm CCCD để nâng cấp quyền Chủ thiết bị (Owner)
      </p>
    </div>

    <!-- Filter Toolbar -->
    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
      <div class="admin-search-pill" style="width: 280px;">
        <i data-lucide="search" style="color: #67BEC3; width: 16px; height: 16px; flex-shrink: 0;"></i>
        <input type="text" id="ownerEkycSearchInput" placeholder="Tìm tên, email, CCCD, SĐT..." />
      </div>
    </div>
  </div>

  <!-- Status Tabs -->
  <div style="display: flex; align-items: center; gap: 8px; border-bottom: 1px solid #E2E8F0; padding-bottom: 12px;">
    <button type="button" class="btn-owner-status-tab active" data-status="all" style="padding: 8px 16px; font-size: 13px; font-weight: 700; border-radius: 12px; border: none; cursor: pointer; background: #E8F6F7; color: #286E74;">
      Tất cả (<%= counts && counts.all !== undefined ? counts.all : (requests ? requests.length : 0) %>)
    </button>
    <button type="button" class="btn-owner-status-tab" data-status="pending" style="padding: 8px 16px; font-size: 13px; font-weight: 600; border-radius: 12px; border: none; cursor: pointer; background: transparent; color: #64748B;">
      Chờ duyệt (<%= counts && counts.pending !== undefined ? counts.pending : 0 %>)
    </button>
    <button type="button" class="btn-owner-status-tab" data-status="approved" style="padding: 8px 16px; font-size: 13px; font-weight: 600; border-radius: 12px; border: none; cursor: pointer; background: transparent; color: #64748B;">
      Đã duyệt (<%= counts && counts.approved !== undefined ? counts.approved : 0 %>)
    </button>
    <button type="button" class="btn-owner-status-tab" data-status="rejected" style="padding: 8px 16px; font-size: 13px; font-weight: 600; border-radius: 12px; border: none; cursor: pointer; background: transparent; color: #64748B;">
      Bị từ chối (<%= counts && counts.rejected !== undefined ? counts.rejected : 0 %>)
    </button>
  </div>

  <!-- Table -->
  <div class="admin-card" style="padding: 0; overflow: hidden;">
    <div class="w-full overflow-x-auto hide-scrollbar admin-table-container">
      <table class="admin-table w-full text-left" style="width: 100%; min-width: 860px; border-collapse: collapse;">
        <thead>
          <tr>
            <th style="min-width: 240px; width: 30%; padding-left: 20px;">Ứng viên nâng cấp</th>
            <th style="min-width: 200px; width: 25%;">Số CCCD & Địa chỉ</th>
            <th style="min-width: 160px; width: 20%;">Ngày nộp & Liên hệ</th>
            <th style="min-width: 120px; width: 12%;">Trạng thái</th>
            <th style="min-width: 120px; width: 13%; text-align: right; padding-right: 24px;">Hành động</th>
          </tr>
        </thead>
        <tbody id="ownerEkycTableBody">
          <% if (!requests || requests.length === 0) { %>
            <tr>
              <td colspan="5" style="text-align: center; padding: 48px; color: #64748B;">
                Chưa có đơn đăng ký nâng cấp Chủ thiết bị (Owner) nào.
              </td>
            </tr>
          <% } else { %>
            <% requests.forEach(function(req) { %>
              <tr
                class="owner-ekyc-row"
                data-id="<%= req._id %>"
                data-name="<%= req.fullName || (req.user && req.user.name) || 'Người dùng TechShare' %>"
                data-email="<%= req.email || (req.user && req.user.email) || '' %>"
                data-phone="<%= req.phone || (req.user && req.user.phone) || '' %>"
                data-address="<%= req.address || (req.user && req.user.address) || 'Chưa cập nhật' %>"
                data-cccd="<%= req.idCardNumber || 'Chưa cập nhật' %>"
                data-date="<%= req.createdAt ? new Date(req.createdAt).toLocaleDateString('vi-VN') : '—' %>"
                data-status="<%= req.status || 'pending' %>"
                data-reason="<%= req.rejectReason || '' %>"
                data-front="<%= req.idCardFrontUrl || '' %>"
                data-back="<%= req.idCardBackUrl || '' %>"
                data-holding="<%= req.idCardHoldingUrl || '' %>"
              >
                <td style="vertical-align: middle; padding-left: 20px;">
                  <div style="display: flex; align-items: center; gap: 12px;">
                    <img
                      src="<%= (req.user && req.user.avatar) || req.idCardHoldingUrl || req.idCardFrontUrl || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=400' %>"
                      alt=""
                      style="width: 44px; height: 44px; min-width: 44px; border-radius: 50%; object-fit: cover; border: 2px solid #E2E8F0;"
                    />
                    <div>
                      <div style="font-weight: 700; color: #0F172A; font-size: 13.5px;" class="owner-user-name">
                        <%= req.fullName || (req.user && req.user.name) || 'Người dùng TechShare' %>
                      </div>
                      <div style="font-size: 11.5px; color: #64748B; margin-top: 2px;">
                        <%= req.email || (req.user && req.user.email) || 'user@techshare.vn' %>
                      </div>
                    </div>
                  </div>
                </td>
                <td style="vertical-align: middle;">
                  <div style="font-weight: 700; font-size: 13px; color: #0F172A; font-family: monospace;">
                    CCCD: <%= req.idCardNumber || 'Chưa có số CCCD' %>
                  </div>
                  <div style="font-size: 11.5px; color: #64748B; margin-top: 2px; max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= req.address || (req.user && req.user.address) %>">
                    <%= req.address || (req.user && req.user.address) || 'Chưa cập nhật địa chỉ' %>
                  </div>
                </td>
                <td style="vertical-align: middle;">
                  <div style="font-size: 12.5px; font-weight: 600; color: #334155;">
                    <%= req.phone || (req.user && req.user.phone) || 'Chưa có SĐT' %>
                  </div>
                  <div style="font-size: 11.5px; color: #94A3B8; margin-top: 2px;">
                    Nộp: <%= req.createdAt ? new Date(req.createdAt).toLocaleDateString('vi-VN') : '—' %>
                  </div>
                </td>
                <td style="vertical-align: middle;" class="owner-status-cell">
                  <% if (req.status === 'approved') { %>
                    <span class="admin-pill-badge" style="background-color: #ECFDF5; color: #16A34A;">Đã duyệt (Owner)</span>
                  <% } else if (req.status === 'rejected') { %>
                    <span class="admin-pill-badge" style="background-color: #FEF2F2; color: #DC2626;">Bị từ chối</span>
                  <% } else { %>
                    <span class="admin-pill-badge" style="background-color: #FEF3C7; color: #D97706;">Chờ duyệt</span>
                  <% } %>
                </td>
                <td style="vertical-align: middle; text-align: right; padding-right: 24px; white-space: nowrap;">
                  <button type="button" class="admin-btn admin-btn-outline btn-inspect-owner" style="padding: 6px 12px; font-size: 12px;">
                    <i data-lucide="<%= req.status === 'pending' ? 'clipboard-check' : 'eye' %>" style="width: 13px; height: 13px;"></i>
                    <span class="btn-inspect-owner-label"><%= req.status === 'pending' ? 'Xét duyệt' : 'Xem chi tiết' %></span>
                  </button>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Thẩm định Hồ sơ Nâng cấp Owner -->
<div id="ownerEkycModal" class="admin-modal-overlay" style="display: none;">
  <div class="admin-modal-card" style="max-width: 760px; width: 95%; max-height: 90vh; overflow-y: auto;" onclick="event.stopPropagation();">
    <div class="admin-modal-header" style="position: sticky; top: 0; background: #FFFFFF; z-index: 10; padding-bottom: 12px; border-bottom: 1px solid #E2E8F0;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <i data-lucide="crown" style="width: 20px; height: 20px; color: #286E74;"></i>
        <h3 class="admin-modal-title" style="margin: 0; font-size: 16px; font-weight: 700; color: #0F172A;">
          Hồ sơ Đăng ký Nâng cấp Chủ thiết bị (Owner)
        </h3>
      </div>
      <button type="button" class="btn-close-owner-modal" style="background: none; border: none; cursor: pointer; color: #94A3B8; padding: 4px;">
        <i data-lucide="x" style="width: 18px; height: 18px;"></i>
      </button>
    </div>

    <!-- Applicant Metadata -->
    <div style="background: #F8FAFC; border-radius: 12px; padding: 16px; margin-top: 16px; border: 1px solid #E2E8F0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
      <div>
        <span style="font-size: 11.5px; color: #64748B; font-weight: 600;">Họ và tên:</span>
        <div id="modalOwnerName" style="color: #0F172A; font-size: 13.5px; font-weight: 700; margin-top: 2px;"></div>
      </div>
      <div>
        <span style="font-size: 11.5px; color: #64748B; font-weight: 600;">Số CCCD:</span>
        <div id="modalOwnerCccd" style="color: #0F172A; font-size: 13.5px; font-weight: 700; font-family: monospace; margin-top: 2px;"></div>
      </div>
      <div>
        <span style="font-size: 11.5px; color: #64748B; font-weight: 600;">Số điện thoại:</span>
        <div id="modalOwnerPhone" style="font-size: 13px; color: #334155; margin-top: 2px;"></div>
      </div>
      <div>
        <span style="font-size: 11.5px; color: #64748B; font-weight: 600;">Email:</span>
        <div id="modalOwnerEmail" style="font-size: 13px; color: #334155; margin-top: 2px;"></div>
      </div>
      <div style="grid-column: 1 / -1;">
        <span style="font-size: 11.5px; color: #64748B; font-weight: 600;">Địa chỉ đăng ký hoạt động:</span>
        <div id="modalOwnerAddress" style="font-size: 13px; color: #334155; margin-top: 2px;"></div>
      </div>
    </div>

    <!-- 3 Photos Dossier (Front, Back, Holding) -->
    <div style="margin-top: 20px;">
      <div style="font-size: 13px; font-weight: 700; color: #0F172A; margin-bottom: 10px; display: flex; align-items: center; justify-content: space-between;">
        <span>Tài liệu ảnh xác thực (3 ảnh bắt buộc)</span>
        <span style="font-size: 11.5px; color: #64748B; font-weight: normal;">Nhấp vào ảnh để xem kích thước lớn</span>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px;">
        <!-- Photo 1: Front -->
        <div style="border: 1px solid #E2E8F0; border-radius: 10px; padding: 10px; background: #FFFFFF; text-align: center;">
          <div style="font-size: 11.5px; font-weight: 700; color: #475569; margin-bottom: 6px;">1. Mặt trước CCCD</div>
          <div style="position: relative; overflow: hidden; border-radius: 6px; cursor: pointer;" class="zoomable-wrapper" data-target="modalImgFront">
            <img id="modalImgFront" src="" alt="Mặt trước CCCD" style="width: 100%; height: 130px; object-fit: cover; display: block; border-radius: 6px; border: 1px solid #CBD5E1;" />
            <div style="position: absolute; bottom: 4px; right: 4px; background: rgba(15,23,42,0.7); color: #fff; padding: 3px 6px; border-radius: 4px; font-size: 10px; display: flex; align-items: center; gap: 3px;">
              <i data-lucide="zoom-in" style="width: 12px; height: 12px;"></i> Phóng to
            </div>
          </div>
        </div>

        <!-- Photo 2: Back -->
        <div style="border: 1px solid #E2E8F0; border-radius: 10px; padding: 10px; background: #FFFFFF; text-align: center;">
          <div style="font-size: 11.5px; font-weight: 700; color: #475569; margin-bottom: 6px;">2. Mặt sau CCCD</div>
          <div style="position: relative; overflow: hidden; border-radius: 6px; cursor: pointer;" class="zoomable-wrapper" data-target="modalImgBack">
            <img id="modalImgBack" src="" alt="Mặt sau CCCD" style="width: 100%; height: 130px; object-fit: cover; display: block; border-radius: 6px; border: 1px solid #CBD5E1;" />
            <div style="position: absolute; bottom: 4px; right: 4px; background: rgba(15,23,42,0.7); color: #fff; padding: 3px 6px; border-radius: 4px; font-size: 10px; display: flex; align-items: center; gap: 3px;">
              <i data-lucide="zoom-in" style="width: 12px; height: 12px;"></i> Phóng to
            </div>
          </div>
        </div>

        <!-- Photo 3: Holding CCCD -->
        <div style="border: 2px solid #67BEC3; border-radius: 10px; padding: 10px; background: #F0FDF4; text-align: center;">
          <div style="font-size: 11.5px; font-weight: 700; color: #166534; margin-bottom: 6px; display: flex; align-items: center; justify-content: center; gap: 4px;">
            <i data-lucide="shield-check" style="width: 13px; height: 13px;"></i> 3. Chân dung cầm CCCD
          </div>
          <div style="position: relative; overflow: hidden; border-radius: 6px; cursor: pointer;" class="zoomable-wrapper" data-target="modalImgHolding">
            <img id="modalImgHolding" src="" alt="Chân dung cầm CCCD" style="width: 100%; height: 130px; object-fit: cover; display: block; border-radius: 6px; border: 1px solid #86EFAC;" />
            <div style="position: absolute; bottom: 4px; right: 4px; background: rgba(22,101,52,0.85); color: #fff; padding: 3px 6px; border-radius: 4px; font-size: 10px; display: flex; align-items: center; gap: 3px;">
              <i data-lucide="zoom-in" style="width: 12px; height: 12px;"></i> Phóng to
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Read-only Status Notices (when approved or rejected) -->
    <div id="ownerApprovedNotice" style="display: none; margin-top: 16px; background: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 10px; padding: 14px 16px; color: #065F46;">
      <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13.5px;">
        <i data-lucide="check-circle-2" style="width: 18px; height: 18px; color: #10B981; flex-shrink: 0;"></i>
        <span>Hồ sơ đã được phê duyệt thành công</span>
      </div>
      <div style="font-size: 12px; color: #047857; margin-top: 4px; margin-left: 26px;">
        Tài khoản người dùng đã được nâng cấp quyền Chủ thiết bị (Owner). Hồ sơ ở trạng thái đóng chỉ xem chi tiết, không thể chỉnh sửa.
      </div>
    </div>

    <div id="ownerRejectedNotice" style="display: none; margin-top: 16px; background: #FEF2F2; border: 1px solid #FECACA; border-radius: 10px; padding: 14px 16px; color: #991B1B;">
      <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13.5px;">
        <i data-lucide="alert-circle" style="width: 18px; height: 18px; color: #EF4444; flex-shrink: 0;"></i>
        <span>Hồ sơ nâng cấp đã bị từ chối</span>
      </div>
      <div style="font-size: 12.5px; color: #B91C1C; margin-top: 6px; margin-left: 26px;">
        <strong>Lý do từ chối:</strong> <span id="ownerRejectedReasonText"></span>
      </div>
      <div style="font-size: 11.5px; color: #7F1D1D; margin-top: 4px; margin-left: 26px;">
        Hồ sơ ở trạng thái đóng chỉ xem chi tiết, không thể chỉnh sửa.
      </div>
    </div>

    <!-- Rejection reason input section (only for pending) -->
    <div id="modalRejectSection" style="margin-top: 18px;">
      <label for="modalRejectReason" style="display: block; font-size: 12px; font-weight: 700; color: #475569; margin-bottom: 6px;">
        Lý do từ chối <span style="color: #EF4444; font-weight: 800;">*</span> (bắt buộc khi chọn Từ chối):
      </label>
      <textarea
        id="modalRejectReason"
        rows="2"
        placeholder="Ví dụ: Ảnh chân dung cầm CCCD không rõ mặt, số CCCD không khớp, hoặc ảnh CCCD bị lóa sáng..."
        style="width: 100%; box-sizing: border-box; padding: 10px 12px; border-radius: 8px; border: 1px solid #CBD5E1; font-size: 13px; color: #0F172A; resize: vertical; outline: none; transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;"
      ></textarea>
      <div id="ownerRejectError" style="display: none; color: #DC2626; font-size: 12px; font-weight: 600; margin-top: 6px; align-items: center; gap: 6px;">
        <i data-lucide="alert-circle" style="width: 14px; height: 14px; flex-shrink: 0;"></i>
        <span>Vui lòng nhập lý do từ chối hồ sơ này.</span>
      </div>
    </div>

    <!-- Modal Status Feedback -->
    <div id="modalStatusAlert" style="display: none; margin-top: 12px; padding: 10px 14px; border-radius: 8px; font-size: 12.5px;"></div>

    <!-- Modal Actions Footer -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 20px; padding-top: 16px; border-top: 1px solid #E2E8F0;">
      <div id="modalCurrentStatusBadge"></div>
      <div style="display: flex; gap: 10px;">
        <button type="button" class="btn-close-owner-modal admin-btn admin-btn-outline">
          Đóng
        </button>
        <div id="ownerPendingActions" style="display: flex; gap: 10px;">
          <button type="button" id="btnRejectOwner" class="admin-btn admin-btn-danger" style="display: flex; align-items: center; gap: 6px;">
            <i data-lucide="x-circle" style="width: 14px; height: 14px;"></i>
            <span>Từ chối đơn</span>
          </button>
          <button type="button" id="btnApproveOwner" class="admin-btn admin-btn-success" style="display: flex; align-items: center; gap: 6px; background-color: #16A34A; color: #FFFFFF;">
            <i data-lucide="check-circle-2" style="width: 14px; height: 14px;"></i>
            <span>Phê duyệt lên Owner 🎉</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal Phóng to Ảnh Zoom -->
<div id="imageZoomModal" class="admin-modal-overlay" style="display: none; z-index: 9999;" onclick="this.style.display='none';">
  <div style="max-width: 90vw; max-height: 90vh; position: relative;" onclick="event.stopPropagation();">
    <button type="button" onclick="document.getElementById('imageZoomModal').style.display='none';" style="position: absolute; top: -14px; right: -14px; width: 32px; height: 32px; border-radius: 50%; background: #0F172A; color: #fff; border: 2px solid #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;">
      <i data-lucide="x" style="width: 16px; height: 16px;"></i>
    </button>
    <img id="zoomModalImg" src="" alt="" style="max-width: 90vw; max-height: 85vh; object-fit: contain; border-radius: 8px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);" />
  </div>
</div>

<section class="admin-card" aria-labelledby="owner-ekyc-title">
  <header class="admin-card-header">
    <h1 class="admin-card-title" id="owner-ekyc-title">Owner Verification</h1>
    <form method="get">
      <label for="owner-ekyc-status">Status</label>
      <select id="owner-ekyc-status" name="status">
        <% Object.entries(statuses).forEach(([value, label]) => { %>
          <option value="<%= value %>" <%= value === status ? 'selected' : '' %>><%= label %></option>
        <% }); %>
      </select>
      <button class="admin-btn admin-btn-outline" type="submit">Filter</button>
    </form>
  </header>
  <% if (requests.length === 0) { %>
    <p>No matching requests found.</p>
  <% } else { %>
    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">Applicant</th>
            <th scope="col">Submitted Date</th>
            <th scope="col">Status</th>
            <th scope="col">Dossier</th>
          </tr>
        </thead>
        <tbody>
          <% requests.forEach((request) => { %>
            <tr>
              <td><strong><%= request.fullName %></strong><br /><%= request.email %></td>
              <td><%= request.createdAt ? new Date(request.createdAt).toLocaleDateString('vi-VN') : '—' %></td>
              <td><%= statuses[request.status] || request.status %></td>
              <td>
                <details>
                  <summary>View dossier of <%= request.fullName %></summary>
                  <p>CCCD <%= request.idCardNumber || '—' %></p>
                  <p><%= request.address %></p>
                  <ul>
                    <% [
                      ['Citizen ID Front', request.idCardFrontUrl],
                      ['Citizen ID Back', request.idCardBackUrl],
                      ['Selfie Holding ID', request.idCardHoldingUrl],
                    ].forEach(([label, url]) => { %>
                      <li>
                        <% if (/^https?:\/\//i.test(url)) { %>
                          <a href="<%= url %>" target="_blank" rel="noreferrer"><%= label %> (open image in new tab)</a>
                        <% } else if (/^data:image\/(png|jpeg|webp);base64,/i.test(url)) { %>
                          <img src="<%= url %>" alt="<%= label %>" loading="lazy" width="160" />
                        <% } else { %>
                          <%= label %> · No image
                        <% } %>
                      </li>
                    <% }); %>
                  </ul>
                  <% if (request.rejectReason) { %>
                    <p>Rejection reason · <%= request.rejectReason %></p>
                  <% } %>
                  <% if (request.status === 'pending') { %>
                    <form method="post" data-owner-ekyc-review="<%= request._id %>">
                      <label for="reason-<%= request._id %>">Rejection reason</label>
                      <textarea id="reason-<%= request._id %>" name="reason" required></textarea>
                      <div>
                        <button class="admin-btn admin-btn-success" type="submit" value="approve" formnovalidate>Approve</button>
                        <button class="admin-btn admin-btn-danger" type="submit" value="reject">Reject</button>
                      </div>
                      <p role="status" aria-live="polite"></p>
                    </form>
                  <% } %>
                </details>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
  <nav aria-label="eKYC requests pagination">
    <% if (page > 1) { %>
      <a href="?status=<%= status %>&amp;page=<%= page - 1 %>">Previous Page</a>
    <% } %>
    <% if (hasNextPage) { %>
      <a href="?status=<%= status %>&amp;page=<%= page + 1 %>">Next Page</a>
    <% } %>
  </nav>
</section>

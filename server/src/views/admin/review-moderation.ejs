<div style="display: flex; flex-direction: column; gap: 20px;">
  <!-- Header -->
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
    <div>
      <h1 style="font-size: 24px; font-weight: 800; color: #0F172A; letter-spacing: -0.02em; margin: 0;">
        Kiểm duyệt Đánh giá & Bảo vệ Uy tín
      </h1>
      <p style="font-size: 12px; color: #64748B; margin-top: 4px; margin-bottom: 0;">
        Giám sát phản hồi người dùng, loại bỏ đánh giá rác và đồng bộ điểm đánh giá thiết bị
      </p>
    </div>
  </div>

  <!-- Reviews Table -->
  <div class="admin-card" style="padding: 0; overflow: hidden;">
    <div class="w-full overflow-x-auto hide-scrollbar admin-table-container">
      <table class="admin-table w-full text-left" style="width: 100%; min-width: 860px; border-collapse: collapse;">
        <thead>
          <tr>
            <th style="min-width: 220px; width: 25%; padding-left: 20px;">Người đánh giá</th>
            <th style="min-width: 200px; width: 24%;">Thiết bị / Đối tác</th>
            <th style="min-width: 140px; width: 16%;">Số sao & Nội dung</th>
            <th style="min-width: 120px; width: 15%;">Trạng thái</th>
            <th style="min-width: 160px; width: 20%; text-align: right; padding-right: 24px;">Hành động</th>
          </tr>
        </thead>
        <tbody>
          <% if (!reviews || reviews.length === 0) { %>
            <tr>
              <td colspan="5" style="text-align: center; padding: 48px; color: #64748B;">
                Chưa có đánh giá nào cần kiểm duyệt.
              </td>
            </tr>
          <% } else { %>
            <% reviews.forEach(function(r) { %>
              <tr class="review-row" data-id="<%= r._id %>">
                <td style="vertical-align: middle; padding-left: 20px;">
                  <div style="font-weight: 700; font-size: 13.5px; color: #0F172A;">
                    <%= r.reviewer && r.reviewer.name ? r.reviewer.name : 'Khách thuê' %>
                  </div>
                  <div style="font-size: 11.5px; color: #64748B;">
                    <%= r.reviewer && r.reviewer.email ? r.reviewer.email : 'user@techshare.vn' %>
                  </div>
                </td>
                <td style="vertical-align: middle;">
                  <div style="font-weight: 600; font-size: 13px; color: #1E293B;">
                    <%= r.device && (r.device.name || r.device.title) ? (r.device.name || r.device.title) : 'Thiết bị công nghệ' %>
                  </div>
                </td>
                <td style="vertical-align: middle;">
                  <div style="display: flex; align-items: center; gap: 3px; color: #EAB308;">
                    <% for (var i = 1; i <= 5; i++) { %>
                      <i data-lucide="star" style="width: 13px; height: 13px; <%= i <= (r.rating || 5) ? 'fill: #EAB308;' : 'color: #CBD5E1;' %>"></i>
                    <% } %>
                    <span style="font-size: 12px; font-weight: 700; color: #0F172A; margin-left: 4px;"><%= r.rating || 5 %></span>
                  </div>
                  <div style="font-size: 12px; color: #475569; margin-top: 4px; max-width: 320px; white-space: normal;">
                    "<%= r.comment || 'Thiết bị dùng rất tốt, chủ máy nhiệt tình.' %>"
                  </div>
                </td>
                <td style="vertical-align: middle;">
                  <% if (r.isHidden || r.moderationStatus === 'hidden') { %>
                    <span class="admin-pill-badge" style="background-color: #FEF2F2; color: #DC2626;">Đã ẩn</span>
                  <% } else { %>
                    <span class="admin-pill-badge" style="background-color: #ECFDF5; color: #16A34A;">Hiển thị</span>
                  <% } %>
                </td>
                <td style="vertical-align: middle; text-align: right; padding-right: 24px; white-space: nowrap;">
                  <% if (r.isHidden || r.moderationStatus === 'hidden') { %>
                    <button type="button" class="admin-btn admin-btn-success btn-moderate-review" data-id="<%= r._id %>" data-status="approved" style="padding: 6px 12px; font-size: 12px;">
                      Khôi phục
                    </button>
                  <% } else { %>
                    <button type="button" class="admin-btn admin-btn-danger btn-moderate-review" data-id="<%= r._id %>" data-status="hidden" style="padding: 6px 12px; font-size: 12px;">
                      Ẩn đánh giá
                    </button>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Sign In — TechShare Admin Portal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/login.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
  <div class="login-page-container">
    <div class="login-card admin-login-card">
      <!-- Header -->
      <div class="login-header">
        <div class="login-badge-pill admin-login-badge-pill">
          <i data-lucide="shield-check" style="width: 14px; height: 14px;"></i>
          Admin Portal
        </div>
        <h1 class="login-title">Admin Sign In</h1>
        <p class="login-subtitle">
          Secure access for platform administrators and governance moderators
        </p>
      </div>

      <!-- Error / Alert Banner -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="login-alert-error" role="alert">
          <i data-lucide="alert-circle" style="width: 16px; height: 16px; flex-shrink: 0; margin-top: 2px;"></i>
          <div><%= error %></div>
        </div>
      <% } %>

      <!-- Form -->
      <form action="/admin/login" method="POST" id="adminLoginForm">
        <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '/admin/dashboard' %>" />

        <div class="login-input-group" style="margin-bottom: 18px;">
          <label for="identifier" class="login-label" style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">
            Username or Email
          </label>
          <div class="login-input-wrapper" style="position: relative; display: flex; align-items: center;">
            <i data-lucide="user" style="position: absolute; left: 14px; width: 17px; height: 17px; color: #94A3B8;"></i>
            <input
              type="text"
              id="identifier"
              name="identifier"
              class="login-input"
              style="width: 100%; padding: 12px 14px 12px 42px; border: 1px solid #CBD5E1; border-radius: 12px; font-size: 14px; outline: none;"
              placeholder="Enter admin username or email"
              required
              autofocus
            />
          </div>
        </div>

        <div class="login-input-group" style="margin-bottom: 24px;">
          <label for="password" class="login-label" style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">
            Password
          </label>
          <div class="login-input-wrapper" style="position: relative; display: flex; align-items: center;">
            <i data-lucide="lock" style="position: absolute; left: 14px; width: 17px; height: 17px; color: #94A3B8;"></i>
            <input
              type="password"
              id="password"
              name="password"
              class="login-input"
              style="width: 100%; padding: 12px 42px 12px 42px; border: 1px solid #CBD5E1; border-radius: 12px; font-size: 14px; outline: none;"
              placeholder="Enter admin password"
              required
            />
            <button
              type="button"
              id="togglePasswordBtn"
              style="position: absolute; right: 14px; background: none; border: none; cursor: pointer; color: #94A3B8; display: flex;"
              onclick="togglePasswordVisibility();"
            >
              <i data-lucide="eye" id="eyeIcon" style="width: 17px; height: 17px;"></i>
            </button>
          </div>
        </div>

        <button
          type="submit"
          class="admin-btn-submit"
          style="width: 100%; padding: 12px; border: none; border-radius: 12px; font-size: 14px; font-weight: 700; color: #FFFFFF; display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer;"
        >
          <span>Sign In to Admin Portal</span>
          <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
        </button>
      </form>

      <!-- Back to Main Site -->
      <div class="admin-back-switch-container">
        <a href="/" class="admin-back-switch-btn">
          <i data-lucide="arrow-left" style="width: 15px; height: 15px;"></i>
          <span>Back to TechShare Marketplace</span>
        </a>
      </div>
    </div>
  </div>

  <script>
    function togglePasswordVisibility() {
      const passwordInput = document.getElementById('password');
      const eyeIcon = document.getElementById('eyeIcon');
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon.setAttribute('data-lucide', 'eye-off');
      } else {
        passwordInput.type = 'password';
        eyeIcon.setAttribute('data-lucide', 'eye');
      }
      if (window.lucide) window.lucide.createIcons();
    }

    if (window.lucide) window.lucide.createIcons();

    // Auto-sync token if arriving from React client with admin privileges
    (function checkLocalStorageToken() {
      const token = localStorage.getItem('techshare_auth_token') || localStorage.getItem('techshare_token');
      if (token && !document.cookie.includes('techshare_admin_token') && !sessionStorage.getItem('techshare_sync_attempted')) {
        sessionStorage.setItem('techshare_sync_attempted', '1');
        fetch('/api/auth/sync-cookie', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token
          },
          credentials: 'include'
        }).then(res => res.json()).then(data => {
          if (data && data.success) {
            sessionStorage.removeItem('techshare_sync_attempted');
            const redirectUrl = new URLSearchParams(window.location.search).get('redirect') || '/admin/dashboard';
            window.location.href = redirectUrl;
          }
        }).catch(() => {});
      }
    })();
  </script>
</body>
</html>

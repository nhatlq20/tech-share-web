<div style="display: flex; flex-direction: column; gap: 20px;">
  <!-- Header -->
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
    <div>
      <h1 style="font-size: 24px; font-weight: 800; color: #0F172A; letter-spacing: -0.02em; margin: 0;">
        Cấu hình Tham số Nền tảng (System Settings)
      </h1>
      <p style="font-size: 12px; color: #64748B; margin-top: 4px; margin-bottom: 0;">
        Quản trị tỷ lệ phí sàn, thời gian xác nhận đơn, hạn mức ký quỹ và chính sách hệ thống
      </p>
    </div>
  </div>

  <!-- Settings List -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px;">
    <% if (!settings || settings.length === 0) { %>
      <div class="admin-card" style="padding: 32px; text-align: center; color: #64748B;">
        Không có cấu hình nào.
      </div>
    <% } else { %>
      <% settings.forEach(function(s) { %>
        <div class="admin-card" style="background: #FFFFFF; border-radius: 16px; padding: 20px; border: 1px solid #E2E8F0; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
              <span style="font-size: 13.5px; font-weight: 800; color: #0F172A; font-family: monospace;">
                <%= s.key %>
              </span>
              <span class="admin-pill-badge" style="background-color: #F1F5F9; color: #475569; text-transform: uppercase; font-size: 10px;">
                <%= s.category || 'general' %>
              </span>
            </div>
            <p style="font-size: 12.5px; color: #64748B; line-height: 1.4; margin-bottom: 12px;">
              <%= s.description || 'Tham số cấu hình hệ thống TechShare.' %>
            </p>
            <div style="background: #F8FAFC; border-radius: 8px; padding: 10px 12px; border: 1px solid #E2E8F0; font-family: monospace; font-size: 13px; font-weight: 700; color: #286E74; word-break: break-all;">
              <%= typeof s.value === 'object' ? JSON.stringify(s.value) : s.value %>
            </div>
          </div>

          <div style="margin-top: 16px; display: flex; justify-content: flex-end;">
            <button
              type="button"
              class="admin-btn admin-btn-outline btn-edit-setting"
              data-key="<%= s.key %>"
              data-value="<%= typeof s.value === 'object' ? JSON.stringify(s.value) : s.value %>"
              data-desc="<%= s.description || '' %>"
              style="padding: 6px 12px; font-size: 12px;"
            >
              Chỉnh sửa tham số
            </button>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>

<!-- Modal Chỉnh sửa Tham số -->
<div id="editSettingModal" class="admin-modal-overlay" style="display: none;">
  <div class="admin-modal-card" style="max-width: 440px;" onclick="event.stopPropagation();">
    <div class="admin-modal-header">
      <h3 class="admin-modal-title">Cập nhật Tham số Cấu hình</h3>
      <button type="button" class="btn-close-modal" style="background: none; border: none; cursor: pointer; color: #94A3B8;">
        <i data-lucide="x" style="width: 18px; height: 18px;"></i>
      </button>
    </div>

    <form id="editSettingForm" style="margin-top: 16px;">
      <div style="margin-bottom: 12px;">
        <label style="display: block; font-size: 12.5px; font-weight: 600; color: #334155; margin-bottom: 4px;">Khóa tham số (Key):</label>
        <input type="text" id="settingModalKey" readonly style="width: 100%; border: 1px solid #CBD5E1; border-radius: 8px; padding: 8px 12px; font-size: 13px; background-color: #F8FAFC; color: #64748B; font-family: monospace;" />
      </div>

      <div style="margin-bottom: 20px;">
        <label style="display: block; font-size: 12.5px; font-weight: 600; color: #334155; margin-bottom: 4px;">Giá trị mới:</label>
        <input type="text" id="settingModalValue" required style="width: 100%; border: 1px solid #CBD5E1; border-radius: 8px; padding: 10px 12px; font-size: 13.5px; outline: none;" />
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" class="admin-btn admin-btn-outline btn-close-modal">Hủy</button>
        <button type="submit" class="admin-btn admin-btn-primary">Lưu cấu hình</button>
      </div>
    </form>
  </div>
</div>

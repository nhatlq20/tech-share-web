<div style="display: flex; flex-direction: column; gap: 24px;">
  <!-- Header -->
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
    <div>
      <h1 style="font-size: 24px; font-weight: 800; color: #0F172A; letter-spacing: -0.02em; margin: 0;">
        Phân quyền & Quản lý Vai trò (Roles & RBAC)
      </h1>
      <p style="font-size: 12px; color: #64748B; margin-top: 4px; margin-bottom: 0;">
        Quản trị ma trận quyền hạn, phân bổ vai trò thành viên và bảo vệ tài khoản quản trị tối cao
      </p>
    </div>
  </div>

  <!-- Role Overview Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px;">
    <% if (roles && roles.length > 0) { %>
      <% roles.forEach(function(r) { %>
        <div class="admin-card" style="background: #FFFFFF; border-radius: 16px; padding: 22px; border: 1px solid #F1F5F9;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
            <div style="font-size: 15px; font-weight: 800; color: #0F172A; text-transform: capitalize;">
              <%= r.name || r.code %>
            </div>
            <span class="admin-pill-badge" style="background-color: #EEF8F8; color: #286E74;">
              <%= r.accountCount || 0 %> tài khoản
            </span>
          </div>
          <p style="font-size: 12.5px; color: #64748B; line-height: 1.5; margin: 0;">
            <%= r.description || 'Vai trò người dùng trong hệ sinh thái TechShare.' %>
          </p>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- Accounts Table -->
  <div class="admin-card" style="padding: 0; overflow: hidden;">
    <div style="padding: 18px 20px; border-bottom: 1px solid #F1F5F9; font-weight: 800; font-size: 15px; color: #0F172A;">
      Danh sách Tài khoản & Vai trò gán
    </div>
    <div class="w-full overflow-x-auto hide-scrollbar admin-table-container">
      <table class="admin-table w-full text-left" style="width: 100%; min-width: 860px; border-collapse: collapse;">
        <thead>
          <tr>
            <th style="min-width: 240px; width: 30%; padding-left: 20px;">Tài khoản / Email</th>
            <th style="min-width: 180px; width: 25%;">Tên đăng nhập (Username)</th>
            <th style="min-width: 140px; width: 20%;">Vai trò hiện tại</th>
            <th style="min-width: 140px; width: 25%; text-align: right; padding-right: 24px;">Điều chuyển vai trò</th>
          </tr>
        </thead>
        <tbody>
          <% if (!accounts || accounts.length === 0) { %>
            <tr>
              <td colspan="4" style="text-align: center; padding: 48px; color: #64748B;">
                Không tìm thấy danh sách tài khoản.
              </td>
            </tr>
          <% } else { %>
            <% accounts.forEach(function(acc) { %>
              <tr class="account-row" data-id="<%= acc._id %>">
                <td style="vertical-align: middle; padding-left: 20px;">
                  <div style="font-weight: 700; font-size: 13.5px; color: #0F172A;">
                    <%= acc.email || 'account@techshare.vn' %>
                  </div>
                </td>
                <td style="vertical-align: middle; font-size: 13px; color: #334155; font-family: monospace;">
                  @<%= acc.username || 'user' %>
                </td>
                <td style="vertical-align: middle;">
                  <%
                    var rCode = acc.roleCode || (acc.roleId && acc.roleId.code) || 'renter';
                    var rBadge = rCode === 'admin' ? { bg: '#F3E8FF', color: '#7E22CE', label: 'Admin' } :
                                 rCode === 'owner' ? { bg: '#E0F2FE', color: '#0369A1', label: 'Owner' } :
                                 { bg: '#F1F5F9', color: '#475569', label: 'Renter' };
                  %>
                  <span class="admin-pill-badge" style="background-color: <%= rBadge.bg %>; color: <%= rBadge.color %>;">
                    <%= rBadge.label %>
                  </span>
                </td>
                <td style="vertical-align: middle; text-align: right; padding-right: 24px;">
                  <button type="button" class="admin-btn admin-btn-outline btn-open-role-modal" data-id="<%= acc._id %>" data-email="<%= acc.email %>" data-role="<%= rCode %>" style="padding: 6px 12px; font-size: 12px;">
                    Gán lại vai trò
                  </button>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Điều chuyển Vai trò -->
<div id="reassignRoleModal" class="admin-modal-overlay" style="display: none;">
  <div class="admin-modal-card" style="max-width: 440px;" onclick="event.stopPropagation();">
    <div class="admin-modal-header">
      <h3 class="admin-modal-title">Điều chuyển Vai trò Tài khoản</h3>
      <button type="button" class="btn-close-modal" style="background: none; border: none; cursor: pointer; color: #94A3B8;">
        <i data-lucide="x" style="width: 18px; height: 18px;"></i>
      </button>
    </div>

    <div style="margin-top: 14px; margin-bottom: 16px;">
      <div style="font-size: 12.5px; color: #64748B;">Tài khoản thay đổi:</div>
      <div id="roleModalAccEmail" style="font-size: 14px; font-weight: 700; color: #0F172A; margin-top: 2px;"></div>
    </div>

    <div style="margin-bottom: 20px;">
      <label style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">
        Chọn vai trò mới:
      </label>
      <select id="selectNewRole" style="width: 100%; border: 1px solid #CBD5E1; border-radius: 8px; padding: 10px; font-size: 13.5px;">
        <option value="admin">Quản trị viên (Admin)</option>
        <option value="owner">Chủ thiết bị (Owner)</option>
        <option value="renter">Khách thuê (Renter)</option>
      </select>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 10px;">
      <button type="button" class="admin-btn admin-btn-outline btn-close-modal">Hủy</button>
      <button type="button" id="btnSubmitRoleChange" class="admin-btn admin-btn-primary">Cập nhật vai trò</button>
    </div>
  </div>
</div>

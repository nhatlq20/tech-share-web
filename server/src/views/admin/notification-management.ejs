<%
  const filters = [
    ['all', 'All Categories'],
    ['ekyc', 'eKYC'],
    ['owner-verification', 'Owner Verification'],
    ['devices', 'Devices'],
    ['reviews', 'Reviews'],
    ['rentals', 'Rentals'],
  ];
  const metrics = [
    ['total', 'inbox', 'Total Notifications', 'Recorded platform events'],
    ['unread', 'mail', 'Unread Notifications', 'Unread for your account'],
    ['pending', 'clipboard-list', 'Pending Actions', 'Open verification and moderation requests'],
  ];
%>
<div id="adminNotificationCenter" class="notification-workspace">
  <header class="notify-heading">
    <div>
      <p class="notify-kicker"><i data-lucide="bell" aria-hidden="true"></i> Notification Center</p>
      <h1>Admin Notifications</h1>
      <p>Stay updated on platform activities that require your attention.</p>
    </div>
    <button id="adminNotificationsReadAll" type="button" class="admin-btn admin-btn-outline" disabled>
      <i data-lucide="check-check" aria-hidden="true"></i> Mark All as Read
    </button>
  </header>

  <section class="notify-summary" aria-label="Notification summary">
    <% for (const [key, icon, label, note] of metrics) { %>
      <article class="admin-card notify-metric">
        <span class="notify-metric-icon"><i data-lucide="<%= icon %>" aria-hidden="true"></i></span>
        <div>
          <h2><%= label %></h2>
          <strong data-notify-metric="<%= key %>">—</strong>
          <p><%= note %></p>
        </div>
      </article>
    <% } %>
  </section>

  <section class="admin-card notify-inbox" aria-labelledby="adminInboxTitle">
    <div class="notify-toolbar">
      <div class="notify-inbox-heading">
        <div><h2 id="adminInboxTitle">Activity Inbox</h2><p>Platform events, newest first.</p></div>
        <span class="notify-results" id="adminNotificationResults" aria-live="polite"></span>
      </div>
      <div class="notify-toolbar-controls">
        <div class="notify-switch" role="group" aria-label="Read state">
          <button type="button" data-notify-state="all" aria-pressed="true">All Notifications</button>
          <button type="button" data-notify-state="unread" aria-pressed="false">Unread</button>
        </div>
        <form id="adminNotificationSearch" class="notify-search" role="search">
          <label for="adminNotificationQuery" class="notify-sr-only">Search notifications</label>
          <div class="notify-search-input">
            <i data-lucide="search" aria-hidden="true"></i>
            <input id="adminNotificationQuery" name="search" type="search" maxlength="120" placeholder="Search notifications…" />
          </div>
          <button type="submit" class="admin-btn admin-btn-outline">Search</button>
        </form>
      </div>
      <div class="notify-categories" role="group" aria-label="Filter by category">
        <% for (const [key, label] of filters) { %>
          <button type="button" data-notify-category="<%= key %>" aria-pressed="<%= key === 'all' %>"><%= label %></button>
        <% } %>
      </div>
    </div>
    <div id="adminNotificationListRegion" aria-busy="true">
      <div id="adminNotificationState" class="notify-state" role="status">Loading notifications…</div>
      <ul id="adminNotificationList" class="notify-list" aria-label="Notification records" hidden></ul>
    </div>
    <nav class="notify-pagination" aria-label="Notification pagination">
      <p id="adminNotificationPage" aria-live="polite"></p>
      <div>
        <button type="button" class="admin-btn admin-btn-outline" id="adminNotificationPrevious" disabled><i data-lucide="chevron-left" aria-hidden="true"></i> Previous</button>
        <button type="button" class="admin-btn admin-btn-outline" id="adminNotificationNext" disabled>Next <i data-lucide="chevron-right" aria-hidden="true"></i></button>
      </div>
    </nav>
  </section>
  <p id="adminNotificationFeedback" class="notify-sr-only" role="status"></p>
</div>

<div style="display: flex; flex-direction: column; gap: 20px;">
  <!-- 1. Header & Search Filters -->
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
    <div>
      <h1 style="font-size: 24px; font-weight: 800; color: #0F172A; letter-spacing: -0.02em; margin: 0;">
        User Management & Trust Scores
      </h1>
    </div>

    <!-- Filter Toolbar -->
    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
      <!-- Search Box -->
      <div class="admin-search-pill" style="width: 280px;">
        <i data-lucide="search" style="color: #67BEC3; width: 16px; height: 16px; flex-shrink: 0;"></i>
        <input
          type="text"
          id="userSearchInput"
          placeholder="Search by name, email, phone..."
          autocomplete="off"
        />
      </div>

      <!-- Role Filter -->
      <select id="roleFilterSelect" style="padding: 8px 14px; border-radius: 9999px; border: 1px solid #E2E8F0; background-color: #FFFFFF; font-size: 13px; color: #334155; cursor: pointer; outline: none;">
        <option value="all">All Roles</option>
        <option value="admin">System Admin (Admin)</option>
        <option value="owner">Equipment Owner (Owner)</option>
        <option value="both">Owner & Renter (Both)</option>
        <option value="renter">Renter (Renter)</option>
      </select>

      <!-- Status Filter -->
      <select id="statusFilterSelect" style="padding: 8px 14px; border-radius: 9999px; border: 1px solid #E2E8F0; background-color: #FFFFFF; font-size: 13px; color: #334155; cursor: pointer; outline: none;">
        <option value="all">All Statuses</option>
        <option value="active">Active</option>
        <option value="locked">Locked</option>
      </select>
    </div>
  </div>

  <!-- 2. Data Table -->
  <div class="admin-card" style="padding: 0; overflow: hidden;">
    <div class="w-full overflow-x-auto hide-scrollbar admin-table-container">
      <table class="admin-table w-full text-left" id="usersTable" style="width: 100%; min-width: 780px; border-collapse: collapse;">
        <thead>
          <tr>
            <th style="min-width: 280px; width: 38%; padding-left: 20px;">Member & Contact</th>
            <th style="min-width: 140px; width: 18%;">Role</th>
            <th style="min-width: 120px; width: 14%;">Trust Score</th>
            <th style="min-width: 120px; width: 14%;">Status</th>
            <th style="min-width: 160px; width: 16%; text-align: right; padding-right: 24px;">Actions</th>
          </tr>
        </thead>
        <tbody id="usersTableBody">
          <% if (!users || users.length === 0) { %>
            <tr id="emptyUsersRow">
              <td colspan="5" style="text-align: center; padding: 56px 20px; color: #64748B; vertical-align: middle;">
                <div style="font-size: 36px; margin-bottom: 10px;">🔍</div>
                <div style="font-weight: 700; font-size: 15px; color: #1E293B;">No matching users found</div>
                <div style="font-size: 13px; margin-top: 4px;">Try changing your search terms or resetting role filters.</div>
              </td>
            </tr>
          <% } else { %>
            <% users.forEach(function(user) { %>
              <tr
                class="user-table-row"
                data-user-id="<%= user._id %>"
                data-name="<%= (user.name || '').toLowerCase() %>"
                data-email="<%= (user.email || '').toLowerCase() %>"
                data-phone="<%= (user.phone || '').toLowerCase() %>"
                data-role="<%= user.role || 'renter' %>"
                data-status="<%= (user.isbanned || !user.isActive) ? 'locked' : 'active' %>"
                data-is-banned="<%= user.isbanned ? 'true' : 'false' %>"
                data-ban-reason="<%= user.banReason || '' %>"
                data-trust-score="<%= user.trustScore || 100 %>"
                data-is-verified="<%= user.isVerified ? 'true' : 'false' %>"
                data-avatar="<%= user.avatar || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=400' %>"
              >
                <!-- Cột 1: Member & Contact -->
                <td style="vertical-align: middle; padding-left: 20px;">
                  <div style="display: flex; align-items: center; gap: 14px;">
                    <img
                      src="<%= user.avatar || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=400' %>"
                      alt="<%= user.name %>"
                      style="width: 44px; height: 44px; min-width: 44px; border-radius: 50%; object-fit: cover; border: 2px solid #E2E8F0; background-color: #F8FAFC; flex-shrink: 0;"
                    />
                    <div style="min-width: 0;">
                      <div style="font-weight: 700; color: #0F172A; font-size: 13.5px; line-height: 1.3; display: flex; align-items: center; gap: 6px;">
                        <span class="user-display-name"><%= user.name %></span>
                        <% if (user.isVerified) { %>
                          <span title="Account verified with national ID (eKYC)" style="display: inline-flex; align-items: center;">
                            <i data-lucide="check-circle-2" style="width: 15px; height: 15px; color: #286E74; fill: #E8F6F7; flex-shrink: 0;"></i>
                          </span>
                        <% } %>
                        <span style="font-size: 11px; color: #94A3B8; font-weight: 500; font-family: monospace;">
                          #<%= String(user._id).slice(-5) %>
                        </span>
                      </div>
                      <div style="display: flex; align-items: center; gap: 12px; margin-top: 4px; flex-wrap: wrap;">
                        <span style="display: inline-flex; align-items: center; gap: 4px; font-size: 12px; color: #64748B;">
                          <i data-lucide="mail" style="width: 12px; height: 12px; color: #94A3B8; flex-shrink: 0;"></i>
                          <%= user.email %>
                        </span>
                        <span style="display: inline-flex; align-items: center; gap: 4px; font-size: 12px; color: #64748B;">
                          <i data-lucide="phone" style="width: 12px; height: 12px; color: #94A3B8; flex-shrink: 0;"></i>
                          <%= user.phone || 'Not updated' %>
                        </span>
                      </div>
                    </div>
                  </div>
                </td>

                <!-- Cột 2: Role -->
                <td style="vertical-align: middle;">
                  <%
                    var bg = user.role === 'admin' ? '#F3E8FF' : user.role === 'owner' ? '#E0F2FE' : user.role === 'both' ? '#E8F6F7' : '#F1F5F9';
                    var color = user.role === 'admin' ? '#7E22CE' : user.role === 'owner' ? '#0369A1' : user.role === 'both' ? '#286E74' : '#475569';
                    var label = user.role === 'admin' ? 'Administrator' : user.role === 'owner' ? 'Device Owner' : user.role === 'both' ? 'Owner & Renter' : 'Renter';
                  %>
                  <span class="admin-pill-badge" style="background-color: <%= bg %>; color: <%= color %>;">
                    <%= label %>
                  </span>
                </td>

                <!-- Cột 3: Trust Score -->
                <td style="vertical-align: middle;">
                  <%
                    var score = typeof user.trustScore === 'number' ? user.trustScore : 100;
                    var tBg = score >= 85 ? '#F0FDF4' : score >= 70 ? '#FEFCE8' : '#FEF2F2';
                    var tColor = score >= 85 ? '#15803D' : score >= 70 ? '#A16207' : '#B91C1C';
                    var tBorder = score >= 85 ? '#BBF7D0' : score >= 70 ? '#FEF08A' : '#FECACA';
                  %>
                  <div style="display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 8px; font-weight: 800; font-size: 12.5px; border: 1px solid <%= tBorder %>; background-color: <%= tBg %>; color: <%= tColor %>;" title="Trust Score: <%= score %>/100">
                    <i data-lucide="shield" style="width: 13px; height: 13px; flex-shrink: 0;"></i>
                    <span><%= score %></span>
                  </div>
                </td>

                <!-- Cột 4: Status -->
                <td style="vertical-align: middle;" class="user-status-cell">
                  <% if (user.isActive && !user.isbanned) { %>
                    <span class="admin-pill-badge active">
                      <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #22C55E; flex-shrink: 0;"></span>
                      Active
                    </span>
                  <% } else { %>
                    <span class="admin-pill-badge locked" title="<%= user.banReason ? ('Lý do: ' + user.banReason) : 'Tài khoản đã bị khóa' %>">
                      <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #EF4444; flex-shrink: 0;"></span>
                      Locked
                    </span>
                    <% if (user.banReason) { %>
                      <div class="user-ban-reason-text" style="font-size: 11.5px; color: #DC2626; font-weight: 500; margin-top: 4px; max-width: 170px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= user.banReason %>">
                        Lý do: <%= user.banReason %>
                      </div>
                    <% } %>
                  <% } %>
                </td>

                <!-- Cột 5: Actions -->
                <td style="vertical-align: middle; text-align: right; padding-right: 24px; white-space: nowrap;">
                  <div style="display: flex; align-items: center; justify-content: flex-end; gap: 12px; min-width: 160px;">
                    <!-- Details -->
                    <button
                      type="button"
                      class="admin-user-btn-detail btn-view-user"
                      title="View User Details"
                    >
                      <i data-lucide="eye" style="width: 13px; height: 13px; flex-shrink: 0;"></i>
                      <span>Details</span>
                    </button>

                    <!-- Lock / Unlock -->
                    <button
                      type="button"
                      class="btn-toggle-status <%= (user.isActive && !user.isbanned) ? 'admin-user-btn-lock' : 'admin-user-btn-unlock' %>"
                      title="<%= (user.isActive && !user.isbanned) ? 'Khóa tài khoản này' : 'Mở khóa tài khoản' %>"
                    >
                      <i data-lucide="<%= (user.isActive && !user.isbanned) ? 'lock' : 'unlock' %>" style="width: 13px; height: 13px; flex-shrink: 0;"></i>
                      <span><%= (user.isActive && !user.isbanned) ? 'Khóa' : 'Mở khóa' %></span>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- MODAL 1: Xác nhận Lock / Unlock tài khoản -->
<div id="lockConfirmModal" class="admin-modal-overlay" style="display: none;">
  <div class="admin-modal-card" style="max-width: 440px;" onclick="event.stopPropagation();">
    <div class="admin-modal-header">
      <div style="display: flex; align-items: center; gap: 8px;">
        <i id="lockModalIcon" data-lucide="alert-triangle" style="width: 20px; height: 20px; color: #DC2626;"></i>
        <h3 id="lockModalTitle" class="admin-modal-title">Confirm Account Lock</h3>
      </div>
      <button type="button" class="btn-close-modal" style="cursor: pointer; color: #94A3B8; border: none; background: none;">
        <i data-lucide="x" style="width: 18px; height: 18px;"></i>
      </button>
    </div>

    <p id="lockModalDesc" style="font-size: 13.5px; color: #475569; line-height: 1.6; margin-top: 14px;">
      Are you sure you want to change the status of this user account?
    </p>

    <!-- Trường nhập Lý do khóa tài khoản (lúc khóa cho nhập lí do) -->
    <div id="banReasonField" style="margin-top: 14px; display: none;">
      <label for="banReasonInput" style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">
        Lý do khóa tài khoản <span style="color: #EF4444;">*</span>:
      </label>
      <textarea
        id="banReasonInput"
        rows="3"
        placeholder="Nhập lý do khóa tài khoản (ví dụ: Vi phạm chính sách bàn giao thiết bị, gian lận thanh toán, thông tin ảo...)"
        style="width: 100%; padding: 10px 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 13px; outline: none; resize: vertical; box-sizing: border-box; font-family: inherit;"
      ></textarea>
      <div id="banReasonError" style="display: none; color: #EF4444; font-size: 12px; margin-top: 4px; font-weight: 500;">
        ⚠️ Vui lòng nhập lý do khóa tài khoản trước khi xác nhận.
      </div>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px;">
      <button type="button" class="admin-btn admin-btn-outline btn-close-modal">Cancel</button>
      <button type="button" id="confirmLockSubmitBtn" class="admin-btn admin-btn-danger">Confirm</button>
    </div>
  </div>
</div>

<!-- User details -->
<div id="userDetailModal" class="admin-modal-overlay" style="display: none;">
  <div class="admin-modal-card" style="max-width: 520px;" onclick="event.stopPropagation();">
    <div class="admin-modal-header">
      <div style="display: flex; align-items: center; gap: 8px;">
        <i data-lucide="user" style="width: 20px; height: 20px; color: #67BEC3;"></i>
        <h3 class="admin-modal-title">User Details</h3>
      </div>
      <button type="button" class="btn-close-modal" style="cursor: pointer; color: #94A3B8; border: none; background: none;">
        <i data-lucide="x" style="width: 18px; height: 18px;"></i>
      </button>
    </div>

    <div style="display: flex; align-items: center; gap: 14px; margin-top: 16px; margin-bottom: 20px;">
      <img id="detailModalAvatar" src="" alt="" style="width: 56px; height: 56px; border-radius: 50%; border: 2px solid #67BEC3; object-fit: cover;" />
      <div>
        <h4 id="detailModalName" style="margin: 0; font-size: 16px; font-weight: 800; color: #0F172A;"></h4>
        <div id="detailModalContact" style="font-size: 12.5px; color: #64748B; margin-top: 2px;"></div>
      </div>
    </div>

    <!-- Thông báo nếu tài khoản đang bị khóa -->
    <div id="detailModalBanBox" style="padding: 12px 16px; background-color: #FEF2F2; border-radius: 12px; border: 1px solid #FECACA; margin-bottom: 16px; display: none;">
      <div style="display: flex; align-items: center; gap: 6px; color: #B91C1C; font-weight: 700; font-size: 13px;">
        <i data-lucide="shield-alert" style="width: 16px; height: 16px;"></i>
        <span>Tài khoản hiện đang bị khóa</span>
      </div>
      <div style="margin-top: 4px; font-size: 12.5px; color: #991B1B;">
        <strong>Lý do:</strong> <span id="detailModalBanReason">Không có lý do cụ thể</span>
      </div>
    </div>

    <div style="padding: 16px; background-color: #F8FAFC; border-radius: 12px; border: 1px solid #E2E8F0;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
        <span style="font-size: 13px; font-weight: 700; color: #1E293B;">Trust Score</span>
        <span id="detailModalTrustScore" style="font-size: 13px; font-weight: 800; color: #286E74;">100/100</span>
      </div>
      <div class="admin-progress-track">
        <div id="detailModalProgressBar" class="admin-progress-bar" style="width: 100%; background-color: #22C55E;"></div>
      </div>
      <p id="detailModalVerifiedNote" style="font-size: 12px; color: #64748B; margin-top: 8px; line-height: 1.5; margin-bottom: 0;">
        ✓ Identity verified with highest National ID level (eKYC).
      </p>
    </div>

    <div style="display: flex; justify-content: flex-end; margin-top: 24px;">
      <button type="button" class="admin-btn admin-btn-primary btn-close-modal">Close</button>
    </div>
  </div>
</div>

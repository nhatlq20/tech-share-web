<header class="admin-topbar">
  <!-- Pill Search Bar -->
  <div class="admin-search-pill">
    <i data-lucide="search" style="color: #67BEC3; width: 16px; height: 16px; flex-shrink: 0;"></i>
    <input
      type="text"
      id="globalAdminSearch"
      placeholder="Quick search devices, users, rentals..."
      autocomplete="off"
    />
  </div>

  <!-- Topbar Right Actions -->
  <div class="admin-topbar-actions">
    <!-- Refresh Button -->
    <button
      type="button"
      id="adminRefreshBtn"
      class="admin-action-btn"
      title="Refresh data"
      onclick="window.location.reload();"
    >
      <i data-lucide="refresh-cw" style="width: 16px; height: 16px;"></i>
    </button>

    <!-- Notification Bell -->
    <div style="position: relative;">
      <button
        type="button"
        id="adminNotifBtn"
        class="admin-action-btn"
        title="System notifications"
        onclick="toggleNotificationDropdown();"
      >
        <i data-lucide="bell" style="width: 16px; height: 16px;"></i>
        <% if (typeof pendingCounts !== 'undefined' && (pendingCounts.ekyc + pendingCounts.devices) > 0) { %>
          <span class="admin-notif-badge">
            <%= (pendingCounts.ekyc + pendingCounts.devices) %>
          </span>
        <% } %>
      </button>

      <!-- Dropdown -->
      <div id="adminNotifDropdown" class="admin-notif-dropdown" style="display: none;">
        <div class="admin-notif-dropdown-header">
          <span style="font-weight: 700; font-size: 13.5px; color: #0F172A;">Admin Notifications</span>
          <span style="font-size: 11px; color: #64748B;">Today</span>
        </div>
        <div class="admin-notif-dropdown-list">
          <% if (typeof pendingCounts !== 'undefined' && pendingCounts.ekyc > 0) { %>
            <a href="/admin/ekyc-verification" class="admin-notif-item">
              <div class="admin-notif-icon" style="background-color: #E8F6F7; color: #286E74;">
                <i data-lucide="shield-check" style="width: 16px; height: 16px;"></i>
              </div>
              <div class="admin-notif-text">
                <div style="font-weight: 600; font-size: 12.5px; color: #0F172A;">New eKYC Verification</div>
                <div style="font-size: 11.5px; color: #64748B;"><%= pendingCounts.ekyc %> eKYC profiles awaiting review.</div>
              </div>
            </a>
          <% } %>
          <% if (typeof pendingCounts !== 'undefined' && pendingCounts.devices > 0) { %>
            <a href="/admin/device-moderation" class="admin-notif-item">
              <div class="admin-notif-icon" style="background-color: #FEF3C7; color: #D97706;">
                <i data-lucide="cpu" style="width: 16px; height: 16px;"></i>
              </div>
              <div class="admin-notif-text">
                <div style="font-weight: 600; font-size: 12.5px; color: #0F172A;">Devices Pending Approval</div>
                <div style="font-size: 11.5px; color: #64748B;"><%= pendingCounts.devices %> devices awaiting listing review.</div>
              </div>
            </a>
          <% } %>
          <% if (typeof pendingCounts === 'undefined' || (pendingCounts.ekyc + pendingCounts.devices) === 0) { %>
            <div style="padding: 24px; text-align: center; color: #94A3B8; font-size: 12.5px;">
              No pending tasks. System operating normally.
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Admin Header Chip -->
    <div class="admin-topbar-profile-chip">
      <img
        src="<%= admin && (admin.avatar || admin.avatarUrl) ? (admin.avatar || admin.avatarUrl) : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&h=100&fit=crop' %>"
        alt="<%= admin && admin.name ? admin.name : 'Admin' %>"
        class="admin-topbar-avatar"
      />
      <div class="admin-topbar-user-info">
        <span class="admin-topbar-name">
          <%= admin && admin.name ? admin.name : 'System Admin' %>
        </span>
        <span class="admin-topbar-role">
          <%= admin && admin.role === 'admin' ? 'System Administrator' : (admin && admin.role ? admin.role : 'Administrator') %>
        </span>
      </div>
    </div>
  </div>
</header>

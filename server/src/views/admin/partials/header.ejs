<header class="admin-topbar">
  <!-- Pill Search Bar -->
  <div class="admin-search-pill">
    <i data-lucide="search" style="color: #67BEC3; width: 16px; height: 16px; flex-shrink: 0;"></i>
    <input
      type="text"
      id="globalAdminSearch"
      placeholder="Quick search devices, users, rentals..."
      autocomplete="off"
    />
  </div>

  <!-- Topbar Right Actions -->
  <div class="admin-topbar-actions">
    <!-- Refresh Button -->
    <button
      type="button"
      id="adminRefreshBtn"
      class="admin-action-btn"
      title="Refresh data"
      onclick="window.location.reload();"
    >
      <i data-lucide="refresh-cw" style="width: 16px; height: 16px;"></i>
    </button>

    <!-- Notification Bell -->
    <div style="position: relative;">
      <button
        type="button"
        id="adminNotifBtn"
        class="admin-action-btn"
        title="Admin notifications"
        style="position: relative;"
        aria-label="Admin notifications"
        aria-controls="adminNotifDropdown"
        aria-expanded="false"
        onclick="toggleNotificationDropdown();"
      >
        <i data-lucide="bell" style="width: 16px; height: 16px;"></i>
        <span class="admin-notif-badge" data-admin-unread-badge hidden></span>
      </button>

      <!-- Dropdown -->
      <div id="adminNotifDropdown" class="admin-notif-dropdown" style="display: none;">
        <div class="admin-notif-dropdown-header">
          <span style="font-weight: 700; font-size: 13.5px; color: #0F172A;">Admin Notifications</span>
          <span id="adminNotifUnreadText" style="font-size: 11px; color: #64748B;"></span>
        </div>
        <div class="admin-notif-dropdown-list">
          <a href="/admin/notification-management" class="admin-notif-item">
            <div class="admin-notif-icon" style="background-color: #E8F6F7; color: #286E74;">
              <i data-lucide="inbox" aria-hidden="true"></i>
            </div>
            <div class="admin-notif-text">
              <strong>Open Notification Center</strong>
              <div style="font-size: 11.5px; color: #64748B;">Review new platform activity.</div>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Admin Header Chip -->
    <div class="admin-topbar-profile-chip">
      <img
        src="<%= admin && (admin.avatar || admin.avatarUrl) ? (admin.avatar || admin.avatarUrl) : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&h=100&fit=crop' %>"
        alt="<%= admin && admin.name ? admin.name : 'Admin' %>"
        class="admin-topbar-avatar"
      />
      <div class="admin-topbar-user-info">
        <span class="admin-topbar-name">
          <%= admin && admin.name ? admin.name : 'System Admin' %>
        </span>
        <span class="admin-topbar-role">
          <%= admin && admin.role === 'admin' ? 'System Administrator' : (admin && admin.role ? admin.role : 'Administrator') %>
        </span>
      </div>
    </div>
  </div>
</header>

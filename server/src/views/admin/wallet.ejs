<div style="display: flex; flex-direction: column; gap: 24px;">
  <!-- Header -->
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
    <div>
      <h1 style="font-size: 24px; font-weight: 800; color: #0F172A; letter-spacing: -0.02em; margin: 0;">
        Escrow Financial Transactions & Wallet Monitoring
      </h1>
      <p style="font-size: 12px; color: #64748B; margin-top: 4px; margin-bottom: 0;">
        Reconcile platform escrow liabilities, customer payments, and platform fee revenue
      </p>
    </div>

    <div style="display: flex; align-items: center; gap: 10px;">
      <a href="/api/admin/wallet/transactions/export" class="admin-btn admin-btn-outline" style="text-decoration: none; font-size: 12px; padding: 8px 14px; display: inline-flex; align-items: center; gap: 6px;">
        <i data-lucide="download" style="width: 14px; height: 14px;"></i>
        <span>Export Statement CSV</span>
      </a>
    </div>
  </div>

  <!-- KPI Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px;">
    <!-- Available User Balances -->
    <div class="admin-card" style="background: #FFFFFF; border-radius: 16px; padding: 22px; border: 1px solid #F1F5F9;">
      <div style="font-size: 12.5px; color: #64748B; font-weight: 600;">Total Available User Wallet Balances</div>
      <div style="font-size: 26px; font-weight: 800; color: #0F172A; margin-top: 6px;">
        <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(overview && overview.totalUserBalance ? overview.totalUserBalance : 142500000) %>
      </div>
    </div>

    <!-- Escrow Held -->
    <div class="admin-card" style="background: #E8F6F7; border-radius: 16px; padding: 22px; border: 1px solid #BCE5E8;">
      <div style="font-size: 12.5px; color: #286E74; font-weight: 600;">Total Held Escrow Deposits (Escrow Liabilities)</div>
      <div style="font-size: 26px; font-weight: 800; color: #286E74; margin-top: 6px;">
        <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(overview && overview.totalEscrowHeld ? overview.totalEscrowHeld : 48500000) %>
      </div>
    </div>

    <!-- Platform Fee -->
    <div class="admin-card" style="background: #FFFFFF; border-radius: 16px; padding: 22px; border: 1px solid #F1F5F9;">
      <div style="font-size: 12.5px; color: #64748B; font-weight: 600;">Total Collected Platform Fees (10%)</div>
      <div style="font-size: 26px; font-weight: 800; color: #16A34A; margin-top: 6px;">
        <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(overview && overview.totalPlatformFee ? overview.totalPlatformFee : 4977000) %>
      </div>
    </div>
  </div>

  <!-- Transactions Table -->
  <div class="admin-card" style="padding: 0; overflow: hidden;">
    <div class="w-full overflow-x-auto hide-scrollbar admin-table-container">
      <table class="admin-table w-full text-left" style="width: 100%; min-width: 860px; border-collapse: collapse;">
        <thead>
          <tr>
            <th style="min-width: 220px; width: 25%; padding-left: 20px;">Tx ID & Transaction Type</th>
            <th style="min-width: 200px; width: 25%;">Beneficiary Member</th>
            <th style="min-width: 160px; width: 20%;">Transaction Amount</th>
            <th style="min-width: 140px; width: 15%;">Thời gian</th>
            <th style="min-width: 140px; width: 15%; text-align: right; padding-right: 24px;">Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (!transactions || transactions.length === 0) { %>
            <tr>
              <td colspan="5" style="text-align: center; padding: 48px; color: #64748B;">
                No wallet transactions recorded yet.
              </td>
            </tr>
          <% } else { %>
            <% transactions.forEach(function(tx) { %>
              <tr>
                <td style="vertical-align: middle; padding-left: 20px;">
                  <div style="font-weight: 800; font-size: 13px; color: #0F172A; font-family: monospace;">
                    #TX-<%= String(tx._id).slice(-6).toUpperCase() %>
                  </div>
                  <div style="font-size: 11.5px; color: #64748B; margin-top: 2px;">
                    <%= tx.type || 'deposit' %>
                  </div>
                </td>
                <td style="vertical-align: middle;">
                  <div style="font-size: 13px; font-weight: 600; color: #1E293B;">
                    <%= tx.user && tx.user.name ? tx.user.name : (tx.userId ? String(tx.userId).slice(-6) : 'Member') %>
                  </div>
                  <div style="font-size: 11.5px; color: #64748B; margin-top: 2px;">
                    <%= tx.user && tx.user.email ? tx.user.email : 'user@techshare.vn' %>
                  </div>
                </td>
                <td style="vertical-align: middle;">
                  <div style="font-size: 13.5px; font-weight: 800; color: <%= tx.amount >= 0 ? '#16A34A' : '#DC2626' %>;">
                    <%= tx.amount >= 0 ? '+' : '' %><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(tx.amount || 0) %>
                  </div>
                </td>
                <td style="vertical-align: middle; font-size: 12px; color: #64748B;">
                  <%= new Date(tx.createdAt || Date.now()).toLocaleString('vi-VN') %>
                </td>
                <td style="vertical-align: middle; text-align: right; padding-right: 24px;">
                  <span class="admin-pill-badge" style="background-color: #ECFDF5; color: #16A34A;">
                    Thành công
                  </span>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div style="display: flex; flex-direction: column; gap: 20px;">
  <!-- Header -->
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
    <div>
      <h1 style="font-size: 24px; font-weight: 800; color: #0F172A; letter-spacing: -0.02em; margin: 0;">
        Quản lý Mã Giảm giá & Khuyến mãi (Voucher)
      </h1>
      <p style="font-size: 12px; color: #64748B; margin-top: 4px; margin-bottom: 0;">
        Thiết lập chiến dịch ưu đãi, giới hạn lượt dùng và bảo vệ an toàn ngân sách khuyến mãi
      </p>
    </div>

    <button type="button" id="btnOpenCreateVoucherModal" class="admin-btn admin-btn-primary" style="font-size: 13px; padding: 8px 16px; display: inline-flex; align-items: center; gap: 6px;">
      <i data-lucide="plus" style="width: 15px; height: 15px;"></i>
      <span>Tạo Voucher mới</span>
    </button>
  </div>

  <!-- Vouchers Table -->
  <div class="admin-card" style="padding: 0; overflow: hidden;">
    <div class="w-full overflow-x-auto hide-scrollbar admin-table-container">
      <table class="admin-table w-full text-left" style="width: 100%; min-width: 860px; border-collapse: collapse;">
        <thead>
          <tr>
            <th style="min-width: 200px; width: 24%; padding-left: 20px;">Mã Voucher & Loại</th>
            <th style="min-width: 180px; width: 22%;">Giá trị ưu đãi</th>
            <th style="min-width: 160px; width: 18%;">Lượt dùng / Giới hạn</th>
            <th style="min-width: 140px; width: 16%;">Ngày hết hạn</th>
            <th style="min-width: 140px; width: 20%; text-align: right; padding-right: 24px;">Trạng thái & Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% if (!vouchers || vouchers.length === 0) { %>
            <tr>
              <td colspan="5" style="text-align: center; padding: 48px; color: #64748B;">
                Chưa có mã giảm giá nào. Hãy tạo mã khuyến mãi đầu tiên!
              </td>
            </tr>
          <% } else { %>
            <% vouchers.forEach(function(v) { %>
              <tr class="voucher-row" data-id="<%= v._id %>">
                <td style="vertical-align: middle; padding-left: 20px;">
                  <div style="font-weight: 800; font-size: 14px; color: #0F172A; font-family: monospace;">
                    <%= v.code %>
                  </div>
                  <div style="font-size: 11.5px; color: #64748B; margin-top: 2px;">
                    <%= v.type === 'percent' ? 'Giảm theo phần trăm (%)' : 'Giảm trực tiếp (Số tiền cố định)' %>
                  </div>
                </td>
                <td style="vertical-align: middle;">
                  <div style="font-weight: 700; font-size: 13.5px; color: #286E74;">
                    <%= v.type === 'percent' ? (v.value + '%') : (new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(v.value)) %>
                  </div>
                  <% if (v.maxDiscount) { %>
                    <div style="font-size: 11px; color: #64748B;">
                      Tối đa: <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(v.maxDiscount) %>
                    </div>
                  <% } %>
                </td>
                <td style="vertical-align: middle;">
                  <div style="font-size: 13px; font-weight: 600; color: #0F172A;">
                    <%= v.usedCount || 0 %> / <%= v.usageLimit || '∞' %>
                  </div>
                  <div style="font-size: 11px; color: #64748B;">lượt đã dùng</div>
                </td>
                <td style="vertical-align: middle; font-size: 12px; color: #475569;">
                  <%= new Date(v.expiryDate).toLocaleDateString('vi-VN') %>
                </td>
                <td style="vertical-align: middle; text-align: right; padding-right: 24px; white-space: nowrap;">
                  <button
                    type="button"
                    class="btn-toggle-voucher-status admin-btn <%= v.isActive ? 'admin-btn-outline' : 'admin-btn-success' %>"
                    data-id="<%= v._id %>"
                    data-active="<%= v.isActive %>"
                    style="padding: 6px 12px; font-size: 12px;"
                  >
                    <%= v.isActive ? 'Tạm dừng' : 'Kích hoạt' %>
                  </button>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Tạo Voucher Mới -->
<div id="createVoucherModal" class="admin-modal-overlay" style="display: none;">
  <div class="admin-modal-card" style="max-width: 480px;" onclick="event.stopPropagation();">
    <div class="admin-modal-header">
      <h3 class="admin-modal-title">Tạo Mã Khuyến Mãi Mới</h3>
      <button type="button" class="btn-close-modal" style="background: none; border: none; cursor: pointer; color: #94A3B8;">
        <i data-lucide="x" style="width: 18px; height: 18px;"></i>
      </button>
    </div>

    <form id="createVoucherForm" style="margin-top: 16px;">
      <div style="margin-bottom: 12px;">
        <label style="display: block; font-size: 12.5px; font-weight: 600; color: #334155; margin-bottom: 4px;">Mã Voucher (Code):</label>
        <input type="text" id="vCode" required style="width: 100%; border: 1px solid #CBD5E1; border-radius: 8px; padding: 8px 12px; font-size: 13px; text-transform: uppercase;" placeholder="VD: TECHSHARE20" />
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 12.5px; font-weight: 600; color: #334155; margin-bottom: 4px;">Loại giảm giá:</label>
          <select id="vType" style="width: 100%; border: 1px solid #CBD5E1; border-radius: 8px; padding: 8px; font-size: 13px;">
            <option value="percent">Phần trăm (%)</option>
            <option value="fixed">Số tiền cố định (₫)</option>
          </select>
        </div>
        <div>
          <label style="display: block; font-size: 12.5px; font-weight: 600; color: #334155; margin-bottom: 4px;">Giá trị giảm:</label>
          <input type="number" id="vValue" required min="1" style="width: 100%; border: 1px solid #CBD5E1; border-radius: 8px; padding: 8px 12px; font-size: 13px;" placeholder="VD: 15 hoặc 50000" />
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 12.5px; font-weight: 600; color: #334155; margin-bottom: 4px;">Giới hạn lượt dùng:</label>
          <input type="number" id="vLimit" required min="1" value="100" style="width: 100%; border: 1px solid #CBD5E1; border-radius: 8px; padding: 8px 12px; font-size: 13px;" />
        </div>
        <div>
          <label style="display: block; font-size: 12.5px; font-weight: 600; color: #334155; margin-bottom: 4px;">Ngày hết hạn:</label>
          <input type="date" id="vExpiry" required style="width: 100%; border: 1px solid #CBD5E1; border-radius: 8px; padding: 8px 12px; font-size: 13px;" />
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
        <button type="button" class="admin-btn admin-btn-outline btn-close-modal">Hủy</button>
        <button type="submit" class="admin-btn admin-btn-primary">Tạo Voucher</button>
      </div>
    </form>
  </div>
</div>

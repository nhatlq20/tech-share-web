<div style="display: flex; flex-direction: column; gap: 20px;">
  <!-- Header -->
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
    <div>
      <h1 style="font-size: 24px; font-weight: 800; color: #0F172A; letter-spacing: -0.02em; margin: 0;">
        Giải quyết Khiếu nại & Tranh chấp Cọc
      </h1>
      <p style="font-size: 12px; color: #64748B; margin-top: 4px; margin-bottom: 0;">
        Phân xử bồi thường thiệt hại thiết bị minh bạch từ khoản ký quỹ Escrow bảo đảm
      </p>
    </div>
  </div>

  <!-- Disputes Table -->
  <div class="admin-card" style="padding: 0; overflow: hidden;">
    <div class="w-full overflow-x-auto hide-scrollbar admin-table-container">
      <table class="admin-table w-full text-left" style="width: 100%; min-width: 900px; border-collapse: collapse;">
        <thead>
          <tr>
            <th style="min-width: 220px; width: 25%; padding-left: 20px;">Mã khiếu nại & Đơn thuê</th>
            <th style="min-width: 240px; width: 30%;">Nguyên nhân tranh chấp</th>
            <th style="min-width: 160px; width: 18%;">Tiền cọc giữ / Yêu cầu</th>
            <th style="min-width: 120px; width: 13%;">Trạng thái</th>
            <th style="min-width: 160px; width: 14%; text-align: right; padding-right: 24px;">Hành động</th>
          </tr>
        </thead>
        <tbody>
          <% if (!disputes || disputes.length === 0) { %>
            <tr>
              <td colspan="5" style="text-align: center; padding: 48px; color: #64748B;">
                Không có tranh chấp hoặc khiếu nại nào cần giải quyết. Hệ thống vận hành an toàn.
              </td>
            </tr>
          <% } else { %>
            <% disputes.forEach(function(disp) { %>
              <tr
                class="dispute-row"
                data-id="<%= disp._id %>"
                data-deposit="<%= disp.depositAmount || 0 %>"
                data-status="<%= disp.status %>"
              >
                <td style="vertical-align: middle; padding-left: 20px;">
                  <div style="font-weight: 800; font-size: 13px; color: #0F172A; font-family: monospace;">
                    #DISP-<%= String(disp._id).slice(-6).toUpperCase() %>
                  </div>
                  <div style="font-size: 11.5px; color: #64748B; margin-top: 2px;">
                    Đơn: #<%= disp.bookingId ? String(disp.bookingId).slice(-6).toUpperCase() : 'N/A' %>
                  </div>
                </td>
                <td style="vertical-align: middle;">
                  <div style="font-size: 13px; font-weight: 600; color: #1E293B;">
                    <%= disp.reason || 'Thiết bị hư hại hoặc trầy xước sau thời gian thuê.' %>
                  </div>
                  <div style="font-size: 11.5px; color: #64748B; margin-top: 2px;">
                    Tạo bởi: <%= disp.raisedBy && disp.raisedBy.name ? disp.raisedBy.name : 'Chủ thiết bị' %>
                  </div>
                </td>
                <td style="vertical-align: middle;">
                  <div style="font-size: 13px; font-weight: 700; color: #286E74;">
                    Cọc: <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(disp.depositAmount || 0) %>
                  </div>
                  <div style="font-size: 11.5px; color: #DC2626; margin-top: 2px;">
                    Yêu cầu: <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(disp.claimAmount || 0) %>
                  </div>
                </td>
                <td style="vertical-align: middle;">
                  <% 
                    var dStatus = {
                      pending: { bg: '#FEF3C7', color: '#D97706', label: 'Chờ xử lý' },
                      in_review: { bg: '#E0F2FE', color: '#0369A1', label: 'Đang thẩm định' },
                      resolved: { bg: '#ECFDF5', color: '#16A34A', label: 'Đã giải quyết' },
                      dismissed: { bg: '#F1F5F9', color: '#64748B', label: 'Đã bác bỏ' },
                    }[disp.status] || { bg: '#F1F5F9', color: '#64748B', label: disp.status };
                  %>
                  <span class="admin-pill-badge" style="background-color: <%= dStatus.bg %>; color: <%= dStatus.color %>;">
                    <%= dStatus.label %>
                  </span>
                </td>
                <td style="vertical-align: middle; text-align: right; padding-right: 24px; white-space: nowrap;">
                  <% if (disp.status === 'pending' || disp.status === 'in_review') { %>
                    <button type="button" class="admin-btn admin-btn-primary btn-resolve-dispute" style="padding: 6px 12px; font-size: 12px;">
                      Phân xử cọc
                    </button>
                  <% } else { %>
                    <span style="font-size: 12px; color: #94A3B8;">Đã đóng</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Giải quyết Tranh chấp -->
<div id="resolveDisputeModal" class="admin-modal-overlay" style="display: none;">
  <div class="admin-modal-card" style="max-width: 480px;" onclick="event.stopPropagation();">
    <div class="admin-modal-header">
      <h3 class="admin-modal-title">Phân xử Khấu trừ Tiền Cọc Escrow</h3>
      <button type="button" class="btn-close-modal" style="background: none; border: none; cursor: pointer; color: #94A3B8;">
        <i data-lucide="x" style="width: 18px; height: 18px;"></i>
      </button>
    </div>

    <div style="margin-top: 16px; margin-bottom: 14px;">
      <label style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">
        Số tiền khấu trừ đền bù cho chủ máy (VNĐ):
      </label>
      <input type="number" id="disputeDeductionInput" style="width: 100%; border: 1px solid #CBD5E1; border-radius: 10px; padding: 10px; font-size: 14px; outline: none;" placeholder="Nhập số tiền khấu trừ..." />
      <div style="font-size: 11.5px; color: #64748B; margin-top: 4px;">
        Tối đa không vượt quá số tiền ký quỹ đang giữ: <strong id="maxDepositLimit">0 ₫</strong>
      </div>
    </div>

    <div style="margin-bottom: 20px;">
      <label style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">
        Ghi chú phân xử của Quản trị viên:
      </label>
      <textarea id="disputeNotesInput" rows="3" style="width: 100%; border: 1px solid #CBD5E1; border-radius: 10px; padding: 10px; font-size: 13px; outline: none;" placeholder="Nhập căn cứ xử lý tranh chấp..."></textarea>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 10px;">
      <button type="button" id="btnDismissDisputeSubmit" class="admin-btn admin-btn-outline">Bác bỏ khiếu nại</button>
      <button type="button" id="btnConfirmResolveSubmit" class="admin-btn admin-btn-success">Xác nhận bồi hoàn</button>
    </div>
  </div>
</div>
